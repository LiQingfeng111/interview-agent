# ============================================================================
#  interview-agent 环境变量模板
#
#  用法：cp .env.example .env，然后填 LLM_API_KEY
#
#  ## 关于地址
#
#  Ollama 和模型网关通常跑在宿主机上。不同部署方式地址不同：
#
#    本机（后端也在宿主机）        http://127.0.0.1:PORT
#    WSL2 + Windows 上的服务       http://<WSL默认网关>:PORT
#                                  （用 `ip route show default | awk '{print $3}'` 查）
#    Docker Desktop               http://host.docker.internal:PORT
#    WSL2 里的 Docker Engine       http://<WSL默认网关>:PORT
#                                  （host.docker.internal 在这个组合下**不通**，实测）
#
#  不确定就用 tools/doctor.sh，它会探测并告诉你该填什么。
# ============================================================================

# ---------------------------------------------------------------- 数据库
POSTGRES_PASSWORD=ia_dev_pwd
# 后端连接串。Docker Compose 里会自动覆盖成服务名（postgres:5432）
DATABASE_URL=postgresql://ia:ia_dev_pwd@127.0.0.1:5432/interview_agent

# ---------------------------------------------------------------- 鉴权
# 生产必须换成随机长串（>= 16 字节）：python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_JWT_SECRET=dev-secret-please-change-in-production

# ---------------------------------------------------------------- 模型
# OpenAI 兼容接口的 base url（要带 /v1）
LLM_BASE_URL=http://127.0.0.1:8000/v1
# 必填。DeepSeek / OpenAI / 通义 / 本地 vLLM 都可以
LLM_API_KEY=
# 你的模型名。示例：deepseek-chat / gpt-4o-mini / qwen2.5-72b-instruct
LLM_MODEL=deepseek-chat

# ---------------------------------------------------------------- 向量
# 跑本地向量模型（推荐，Ollama 一条命令：ollama pull bge-m3）
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 向量维度。bge-m3 = 1024。换模型时**必须**同步改数据库列定义并重建索引
EMBEDDING_DIM=1024

# ---------------------------------------------------------------- 缓存（可选）
# 留空则用进程内存缓存（单实例够用）
REDIS_URL=

# ---------------------------------------------------------------- 服务
IA_HOST=0.0.0.0
IA_PORT=8080
IA_CORS_ORIGINS=http://localhost:5173,http://localhost:8081
